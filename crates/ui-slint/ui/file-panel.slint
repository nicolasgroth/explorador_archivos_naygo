//
// Columnas repartidas con `horizontal-stretch` (50/15/15/20) para evitar bucles de
// binding. Cada panel emite sus callbacks con su `pane-id` para que el controller sepa
// sobre cuál actuar; el panel activo lleva borde de acento.
import { ListView, LineEdit, ScrollView } from "std-widgets.slint";
import { RowData, PathSeg, ColumnVm, ColumnToggleVm } from "types.slint";
import { Tr } from "i18n.slint";
import { Theme } from "theme.slint";
import { BreadcrumbBar } from "breadcrumb-bar.slint";

// Íconos dibujados con Path (no glifos de fuente): bajo render por software los emoji/★/✓
// salían invisibles. `fill`/`stroke` los pinta el llamador según estado.

// Estrella de 5 puntas. `filled` la rellena (favorito activo) o solo la contornea.
component StarIcon inherits Rectangle {
    in property <bool> filled: false;
    in property <color> tint: Theme.highlight;
    in property <length> size: 15px;
    Path {
        width: root.size;
        height: root.size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        fill: root.filled ? root.tint : transparent;
        stroke: root.tint;
        stroke-width: 1.2px;
        viewbox-width: 20;
        viewbox-height: 20;
        MoveTo { x: 10; y: 1; }
        LineTo { x: 12.6; y: 7.1; }
        LineTo { x: 19; y: 7.6; }
        LineTo { x: 14.2; y: 11.8; }
        LineTo { x: 15.7; y: 18; }
        LineTo { x: 10; y: 14.7; }
        LineTo { x: 4.3; y: 18; }
        LineTo { x: 5.8; y: 11.8; }
        LineTo { x: 1; y: 7.6; }
        LineTo { x: 7.4; y: 7.1; }
        Close { }
    }
}

// Portapapeles (copiar): hoja con una pestañita arriba.
component ClipboardIcon inherits Rectangle {
    in property <color> tint: Theme.text;
    in property <length> size: 14px;
    Path {
        width: root.size;
        height: root.size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: root.tint;
        stroke-width: 1.2px;
        fill: transparent;
        viewbox-width: 16;
        viewbox-height: 16;
        // Hoja.
        MoveTo { x: 3; y: 3; }
        LineTo { x: 13; y: 3; }
        LineTo { x: 13; y: 15; }
        LineTo { x: 3; y: 15; }
        Close { }
        // Pestaña superior.
        MoveTo { x: 6; y: 1.5; }
        LineTo { x: 10; y: 1.5; }
        LineTo { x: 10; y: 4; }
        LineTo { x: 6; y: 4; }
        Close { }
    }
}

// Tilde (✓) para el feedback "copiado".
component CheckIcon inherits Rectangle {
    in property <color> tint: Theme.highlight;
    in property <length> size: 14px;
    Path {
        width: root.size;
        height: root.size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        stroke: root.tint;
        stroke-width: 1.8px;
        fill: transparent;
        viewbox-width: 16;
        viewbox-height: 16;
        MoveTo { x: 2.5; y: 8.5; }
        LineTo { x: 6.5; y: 12.5; }
        LineTo { x: 13.5; y: 3.5; }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> align-right: false;
    in property <int> sort-dir: 0;      // 0=ninguno 1=asc 2=desc (F2)
    in property <bool> has-filter: false;// embudo si hay filtro activo (F2)
    callback clicked();
    // Clic derecho → abre el menú de columna (ordenar/filtrar/ocultar) (F2).
    callback context-menu(length, length);
    // Redimensionar: `delta` en px arrastrados sobre el asa del borde derecho (6C).
    callback resize(length);
    background: hcell-touch.has-hover ? Theme.hover-bg : Theme.header-bg;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.divider;
    }
    HorizontalLayout {
        x: 6px;
        width: parent.width - 12px;
        spacing: 3px;
        // Embudo a la izquierda cuando hay filtro activo en esta columna.
        if root.has-filter: Text {
            text: "⏷";
            color: Theme.accent;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.text-dim;
            font-weight: 600;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            horizontal-alignment: root.align-right ? right : left;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // Indicador de orden ▲/▼ a la derecha de la etiqueta.
        if root.sort-dir != 0: Text {
            text: root.sort-dir == 1 ? "▲" : "▼";
            color: Theme.accent;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
    hcell-touch := TouchArea {
        // El asa de resize ocupa los últimos 6px del borde derecho; el resto ordena al hacer clic.
        width: parent.width - 6px;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                root.context-menu(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.clicked();
        }
    }
    // Asa de redimensionado: barra de 6px en el borde derecho. Arrastrar cambia el ancho.
    resize-handle := TouchArea {
        x: parent.width - 6px;
        width: 6px;
        mouse-cursor: ew-resize;
        property <length> start-x;
        property <bool> resizing: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.resizing = true;
                self.start-x = self.mouse-x;
            }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left && self.resizing) {
                self.resizing = false;
                root.resize(self.mouse-x - self.start-x);
            }
            if (ev.kind == PointerEventKind.cancel) {
                self.resizing = false;
            }
        }
    }
}

// Botón de navegación compacto de cada FilePanel. Mantiene los controles junto a la ruta a la
// que pertenecen sin duplicar una barra completa; 20px conserva un blanco cómodo aun en layouts
// densos. Los glifos se limitan a flechas básicas que el renderer por software maneja bien.
component PanelNavButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();
    callback history-menu(length);
    callback hover-tip(string, length, length);
    width: 20px;
    height: 22px;
    border-radius: Theme.radius-sm;
    background: nav-touch.has-hover && root.enabled ? Theme.hover-bg : transparent;
    Text {
        text: root.glyph;
        color: root.enabled ? Theme.text : Theme.text-dim.with-alpha(0.45);
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    nav-touch := TouchArea {
        enabled: root.enabled;
        property <bool> holding: false;
        property <bool> opened-history: false;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.holding = true;
                self.opened-history = false;
                hold-timer.running = true;
            }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                hold-timer.running = false;
                if (self.holding && !self.opened-history) { root.clicked(); }
                self.holding = false;
            }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                hold-timer.running = false;
                self.holding = false;
                root.history-menu(root.absolute-position.x + root.width / 2);
            }
            if (ev.kind == PointerEventKind.cancel) {
                hold-timer.running = false;
                self.holding = false;
            }
        }
        changed has-hover => {
            root.hover-tip(self.has-hover ? root.tip : "",
                root.absolute-position.x + root.width / 2,
                root.absolute-position.y + root.height);
        }
    }
    hold-timer := Timer {
        interval: 480ms;
        running: false;
        triggered => {
            self.running = false;
            if (nav-touch.holding) {
                nav-touch.opened-history = true;
                root.history-menu(root.absolute-position.x + root.width / 2);
            }
        }
    }
}

// Una opción del aviso "carpeta no encontrada" (reintentar / subir / elegir / cerrar).
// Encapsula el recuadro con hover + texto + TouchArea para no duplicar el markup entre el
// `for` de las opciones y el botón "subir" que va aparte (condicionado por missing-has-ancestor).
component MissingOpButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 32px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: opt-touch.has-hover ? Theme.active-pane-border : Theme.divider;
    background: opt-touch.has-hover ? Theme.hover-bg : Theme.surface-raised;
    Text {
        text: root.label;
        color: Theme.text;
        vertical-alignment: center;
        x: 12px;
    }
    opt-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component FilePanel inherits FocusScope {
    in property <int> pane-id;
    in property <bool> active;
    // Se está ARRASTRANDO un archivo sobre ESTE panel ahora mismo: borde marcado + path-bar
    // remarcada, para indicar dónde caerá el drop. Manda sobre `active` mientras dura el arrastre.
    in property <bool> drag-over: false;
    // Coordenada Y lógica de cliente del cursor de un arrastre OLE. Viene del hit-test nativo y
    // se compara con `list.absolute-position.y` para obtener la fila REAL aun con scroll. No se
    // usa el TouchArea de la app durante DoDragDrop: Windows captura esos eventos en su loop OLE.
    in property <length> drag-client-y: -10000px;
    // Reporta -1 para encabezado/zona vacía/archivo y el índice de vista cuando hay una fila.
    // Rust decide después si esa fila sigue siendo una carpeta y, solo entonces, la usa de destino.
    callback drop-target-row(int, int);
    // Hay un MODAL de operación abierto (conflicto/eliminar/aviso, etc.). Mientras sea true se
    // DESMONTA el `body-touch` exterior (ver más abajo) para que NO robe hover/clic/arrastre al
    // velo del modal: sin esto el popup queda con el hover muerto hasta el primer clic, y arrastrar
    // resalta filas que no debería. Al cerrar el modal vuelve a false → el TouchArea se re-monta.
    in property <bool> modal-open: false;
    // Hay un arrastre OLE EN CURSO (DoDragDrop corriendo su bucle modal de Windows). Rust lo pone
    // en true al lanzar el arrastre y en false cuando termina (drop procesado o cancelado). Mientras
    // es true DESMONTAMOS el `body-touch` exterior — igual que con `modal-open` — por una razón de
    // SEGURIDAD DE DATOS: el bucle modal de DoDragDrop CAPTURA el mouse y NUNCA devuelve el
    // `pointer-up` al TouchArea del panel origen, que quedaría con `pressed-here`/grab de puntero sin
    // liberar. Tras el drag, el cursor sobre OTRO panel seguiría llegando al body-touch del ORIGEN,
    // resaltando/seleccionando la fila a su misma altura (captura fantasma). Al desmontar y re-montar
    // el TouchArea nace con el estado del gesto LIMPIO y sin grab huérfano. Es la misma técnica que
    // ya usa `modal-open`, reaprovechada.
    in property <bool> drag-in-progress: false;
    in property <[RowData]> rows;
    in property <[ColumnVm]> columns;        // columnas visibles (orden/ancho/alineación) (6C)
    in property <[ColumnToggleVm]> col-menu; // TODAS las columnas para el menú agregar/quitar (6C)
    in property <length> row-h: 22px;        // alto de fila (densidad configurable)
    // Clave de NAVEGACIÓN del panel: la carpeta actual (PaneVm.path). Cambia SOLO al navegar —
    // Rust la actualiza únicamente cuando la ruta difiere — y es lo que resetea el scroll a
    // arriba (ver `changed nav-key`). No confundir con un refresco de contenido (watcher/F5),
    // que NO debe mover el scroll del usuario.
    in property <string> nav-key;
    // Índice de VISTA de la fila enfocada (-1 = ninguna). Lo pasa Rust desde `f.focused`. Al
    // cambiar, el cuerpo ajusta el viewport nativo para REVELAR esa fila:
    // así navegar con ↑↓/Re-Av Pág/Inicio-Fin/typeahead/paleta vuelve a arrastrar la vista tras
    // el cursor. La ListView dejó de ser interactiva y ya no auto-scrollea sola.
    in property <int> focused-row: -1;
    in property <int> restore-scroll-row: -1;
    // Incluye la carpeta para volver a aplicar el mismo índice al visitar otra entrada histórica.
    in property <string> restore-scroll-key;
    // El ListView se deja no-interactivo para que no cancele los gestos de arrastre/rubber-band,
    // pero la rueda y el teclado escriben DIRECTO en su `viewport-y` nativo. Antes manteníamos un
    // `wheel-scroll` paralelo y lo enlazábamos al viewport: en listados virtualizados ambos podían
    // quedar desfasados y el foco continuaba "por detrás" de la vista. El viewport nativo es ahora
    // la única fuente de verdad (0 arriba; valores negativos hacia abajo).
    property <int> revealed-focus-row: -1;
    property <string> applied-scroll-key;
    // Espejo reactivo del alto útil de la lista. Tras navegar, el foco puede llegar desde Rust
    // antes del primer layout (cuando `list.visible-height` todavía es 0); observar esta
    // propiedad vuelve a intentar revelar la fila apenas Slint conoce el alto real. También
    // mantiene visible el foco al redimensionar el panel o abrir/cerrar paneles vecinos.
    property <length> list-visible-height: list.visible-height;
    // Fila bajo el cursor según el TouchArea exterior (-1 = ninguna/zona vacía). La pinta el
    // fondo de cada fila para el efecto hover (antes lo daba el `has-hover` del row-touch).
    property <int> hover-row: -1;
    // Hit-test para D-1. `absolute-position` y `drag-client-y` comparten el sistema de
    // coordenadas lógico de cliente; `viewport-y` es negativo al bajar, igual que en body-touch.
    // Se ejecuta con cada DragOver que Rust recibe de OLE, no durante el listado ni en el UI thread
    // haciendo I/O. La comprobación de rango impide convertir el espacio vacío en un destino.
    changed drag-client-y => {
        let row = floor((root.drag-client-y - list.absolute-position.y - list.viewport-y) / root.row-h);
        root.drop-target-row(root.pane-id,
            row >= 0 && row < root.rows.length ? row : -1);
    }
    // Al NAVEGAR (cambia la carpeta del panel), el viewport vuelve arriba y el próximo foco se
    // revela otra vez: si no, la carpeta nueva heredaría el offset de la anterior.
    changed nav-key => {
        list.viewport-y = 0px;
        root.revealed-focus-row = -1;
    }
    // NOTA (medido en vivo): un `changed rows` aquí NO dispara con `set_vec` (mutar el
    // contenido del VecModel no cambia el valor de la propiedad-modelo), así que el reset del
    // scroll debe colgarse de `nav-key` (arriba) y NO de `rows` — el reset-en-rows que había
    // antes era código muerto y la carpeta nueva heredaba el scroll de la anterior.
    // Auto-scroll por teclado: cuando el foco se mueve, ajusta `list.viewport-y` lo mínimo para
    // que la fila enfocada quede completamente visible dentro del viewport del ListView.
    //   · ventana visible = [-viewport-y, -viewport-y + visible-height]
    //   · borde superior de la fila = focused-row * row-h ; inferior = (focused-row + 1) * row-h
    // Si la fila está por ENCIMA de la ventana → llevar el scroll a su borde superior; si está por
    // DEBAJO → llevar el fondo de la fila al borde inferior. Si ya se ve, no se toca. Todo se
    // recorta a [0, alto-total - alto-visible]. Si `visible-height` vale 0 antes del primer
    // layout, `changed list-visible-height` vuelve a llamar esta función al asentarse.
    function reveal-focused-row() {
        if (root.focused-row >= 0 && list.visible-height > 0px) {
            // Tope inferior posible del scroll (no pasar del final de la lista).
            list.viewport-y = -clamp(
                // ¿La fila cae por debajo del borde inferior? Empujar para revelarla por abajo.
                ((root.focused-row + 1) * root.row-h > -list.viewport-y + list.visible-height)
                    ? (root.focused-row + 1) * root.row-h - list.visible-height
                    // ¿Por encima del borde superior? Subir hasta su borde superior.
                    : (root.focused-row * root.row-h < -list.viewport-y
                        ? root.focused-row * root.row-h
                        // Ya visible: dejar el scroll como está.
                        : -list.viewport-y),
                0px,
                max(0px, root.rows.length * root.row-h - list.visible-height));
            root.scroll-position-changed(root.pane-id, floor(-list.viewport-y / root.row-h));
        }
    }
    // El foco y las filas llegan desde modelos distintos: al abrir una carpeta grande puede
    // llegar el foco antes de que ListView haya recalculado su alto virtual. Diferimos un turno
    // para revelar contra la geometría final; mientras el foco no cambie no toca la rueda manual.
    Timer {
        interval: 0ms;
        running: root.focused-row >= 0 && root.revealed-focus-row != root.focused-row;
        triggered => {
            root.reveal-focused-row();
            root.revealed-focus-row = root.focused-row;
        }
    }
    changed list-visible-height => { root.revealed-focus-row = -1; }
    // La restauración espera al layout definitivo del ListView. Marca el foco como ya revelado:
    // foco y scroll son contexto independiente y un foco fuera de pantalla no debe pisar el
    // scroll manual que el usuario dejó en esa visita.
    Timer {
        interval: 0ms;
        running: root.restore-scroll-row >= 0
            && root.restore-scroll-key != root.applied-scroll-key
            && list.visible-height > 0px;
        triggered => {
            list.viewport-y = -clamp(
                root.restore-scroll-row * root.row-h,
                0px,
                max(0px, root.rows.length * root.row-h - list.visible-height));
            root.applied-scroll-key = root.restore-scroll-key;
            root.revealed-focus-row = root.focused-row;
        }
    }
    // --- Barra de ruta (breadcrumbs + edición + autocompletado) ---
    in property <[PathSeg]> segments;        // breadcrumbs de la carpeta actual
    in property <bool> editing;              // este panel está editando su ruta
    // Flujo bidireccional: el LineEdit conserva su propio caret mientras se escribe y Rust
    // aún puede reemplazar el buffer al aceptar una sugerencia. Un binding de una sola vía
    // reescribía el texto tras cada `edited`, dejando el cursor a mitad de la ruta.
    in-out property <string> edit-text;
    in property <[string]> suggestions;      // autocompletado del editor
    // Offset UTF-8 a restaurar tras completar una sugerencia. -1 = no forzar el caret.
    in property <int> edit-caret: -1;
    in property <int> edit-caret-revision: 0;
    // Candidato de autocompletado resaltado por teclado (-1 = ninguno). Mantener el
    // foco en el LineEdit permite escribir, ↑/↓ elegir y Enter completar sin tocar el mouse.
    property <int> suggestion-index: -1;
    in property <bool> is-favorite;          // la carpeta actual está en favoritos (★ llena)
    in property <bool> no-matches;           // filtro activo que vació la vista → aviso (F2)
    // Carpeta no encontrada / ilegible: muestra el aviso IN-PLACE con opciones.
    in property <bool> missing;
    in property <string> missing-path;       // la ruta perdida (para mostrarla)
    in property <bool> missing-has-ancestor;  // ¿hay un ancestro existente al que subir? (ver FIX 2)
    in property <bool> missing-ejected;      // ¿la pérdida fue por expulsión de disco? (cambia el texto)
    callback missing-retry(int);             // (pane-id) reintentar
    callback missing-ancestor(int);          // (pane-id) subir al ancestro existente
    callback missing-choose(int);            // (pane-id) elegir otra carpeta (selector nativo)
    callback missing-close(int);             // (pane-id) cerrar el panel
    callback fav-toggle(int);                // (pane-id) anclar/quitar la carpeta de favoritos
    callback copy-path(int);                 // (pane-id) copiar la ruta al portapapeles
    // Tooltip de los íconos de la path-bar: (texto-o-vacío, x-centro, y-borde-inferior) en coords
    // de ventana. La AppWindow lo pinta en su overlay JUSTO debajo del ícono. Vacío al salir el mouse.
    callback hover-tip(string, length, length);
    // --- Rename inline (6D): la fila `rename-pos` muestra un editor en la celda Name. ---
    in property <int> rename-pos: -1;        // posición de vista en edición (-1 = ninguna)
    in property <string> rename-text;        // nombre inicial del editor
    in property <int> rename-session: 0;      // identidad estable; invalida callbacks tardíos
    in property <int> rename-selection-start: 0; // offsets UTF-8 para el ciclo de selección F2
    in property <int> rename-selection-end: 0;
    // Texto VIVO del editor de rename (bidireccional con la ventana). El editor edita ESTA
    // propiedad, no `rename-text`: si el delegate de la fila se re-monta (rebuild de filas
    // por watcher/listado), el editor vuelve con lo que el usuario ya tipeó y NO con el
    // nombre original seleccionado (bug: tipear "_" al final reemplazaba todo el texto).
    in-out property <string> rename-draft: "";
    // Posición del cursor a restaurar tras un RE-MONTAJE del delegate (offset UTF-8). La
    // fija Rust al recibir `rename-edited` (= fin del texto tipeado: LineEdit no expone
    // cursor-position en Slint 1.16, y al tipear el cursor va al final). Sin esto el cursor
    // saltaba al inicio y la siguiente tecla insertaba ahí (el "_" "al principio del nombre").
    in property <int> rename-cursor: 0;
    callback rename-edited(string);           // texto vivo del editor → Rust guarda el largo
    // true una vez aplicada la selección inicial del ciclo F2 en ESTA sesión: un re-montaje
    // posterior solo retoma el foco, NO re-selecciona (re-seleccionar haría que la siguiente
    // tecla reemplace todo el draft).
    property <bool> rename-seeded: false;
    callback rename-commit(int, int, string);     // (sesión, pos, nombre) Enter → renombrar
    callback rename-chain(int, int, string, int); // (sesión, pos, nombre, dir) ↑/↓
    callback rename-cycle();                   // F2 dentro del editor: ciclar la selección
                                               // (nombre → extensión → todo → nombre)
    callback rename-cancel();                // Esc → cerrar
    callback segment-clicked(int, string);   // (pane-id, ruta) clic en un breadcrumb → navegar
    callback segment-context(int, string, length, length); // clic derecho → menú de esa carpeta
    callback path-edit-start(int);           // (pane-id) entrar a modo edición
    callback path-edit-changed(int, string); // (pane-id, texto) recalcular autocompletado
    callback path-edit-commit(int, string);  // (pane-id, texto) Enter → navegar
    callback path-edit-cancel(int);          // (pane-id) Esc → salir de edición
    callback suggestion-clicked(int, string);// (pane-id, nombre) elegir un candidato
    callback row-clicked(int, int, bool, bool);  // (pane-id, pos, ctrl, shift) — modificadores del clic
    callback row-double-clicked(int, int);
    callback row-middle-clicked(int, int);   // (pane-id, pos) — clic-medio: abrir carpeta en panel nuevo
    callback row-drag-out(int);              // (pane-id) inicia el arrastre OLE de lo selecto
    callback scroll-position-changed(int, int); // (pane-id, primera fila visible)
    callback rubber-band(int, int, int);     // (pane-id, from-pos, to-pos) selección por rectángulo
    callback row-context(int, int, length, length); // (pane-id, pos, x-ventana, y-ventana)
    // Clic derecho en la ZONA VACÍA del panel: menú contextual de la CARPETA (Explorador,
    // terminal, nueva carpeta…), no de un archivo. (pane-id, x-ventana, y-ventana)
    callback empty-context(int, length, length);
    callback sort-by(int, string);           // (pane-id, columna) — legado (no usado por el header)
    callback sort-by-kind(int, int);         // (pane-id, kind) ordenar por columna dinámica
    callback column-toggle(int, int);        // (pane-id, kind) mostrar/ocultar columna
    callback column-move(int, int, int);     // (pane-id, from, to) reordenar columnas
    callback column-resize(int, int, length);// (pane-id, kind, ancho) redimensionar
    callback column-context(int, int, length, length); // (pane-id, kind, x, y) clic derecho en header (F2)
    // Menú de columnas abierto (clic en "Columnas…"): muestra los toggles.
    property <bool> col-menu-open: false;
    callback activate(int);                  // (pane-id) al interactuar
    callback key(string, bool, bool, bool);
    // Soltado de tecla: reporta el estado REAL de los modificadores tras el release, para que
    // Rust resetee `ctrl_down`/`shift_down`. Sin esto, un Ctrl pegado tras Ctrl+C hacía que el
    // siguiente doble-clic en carpeta abriera-en-otro-panel en vez de navegar.
    callback key-release(bool, bool, bool);  // (ctrl, shift, alt) — modificadores vigentes
    // Botones laterales del mouse (atrás/adelante) sobre este panel: navegan su historial.
    callback nav-back(int);                  // (pane-id)
    callback nav-forward(int);               // (pane-id)
    callback nav-up(int);                    // (pane-id)
    // Los ▾ muestran el historial DE ESTE panel, incluso si otro panel era el activo antes del clic.
    callback open-back-history(int, length); // (pane-id, x de anclaje)
    callback open-forward-history(int, length);
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    // Vista profunda (recursiva): toggle en la barra + estado on/off.
    in property <bool> deep-active: false;
    callback toggle-deep(int);               // (pane-id)
    in property <bool> comparison-active: false;
    in property <bool> comparison-link-available: false;
    in property <bool> comparison-link-active: false;
    callback comparison-select(int, int);    // (pane-id, 0=todos 1=distintos 2=solo aquí)
    callback comparison-transfer(int, bool); // (pane-id, false=copiar true=mover)
    callback comparison-toggle-link(int);
    // Barra inferior (footer): texto de selección/espacio de disco. Vacío = barra oculta.
    in property <string> footer-text;
    // Texto del volumen separado para alinearlo a la derecha (libre / total / % usado).
    in property <string> footer-disk-text;
    // Etiqueta del filtro visual por tipeo activo en ESTE panel (`filtro: "x" · N`, ya
    // traducida). Vacío = sin filtro → la mini-barra no se muestra.
    in property <string> filter-label;
    callback filter-clear(int);              // (pane-id) clic en la ✕ de la mini-barra de filtro
    in property <bool> filter-hiding;
    callback filter-toggle-hide(int);        // alterna marcar/ocultar no-coincidencias

    function move-suggestion(delta: int) {
        if (root.suggestions.length == 0) { return; }
        if (root.suggestion-index < 0) {
            root.suggestion-index = delta > 0 ? 0 : root.suggestions.length - 1;
        } else {
            root.suggestion-index = Math.mod(
                root.suggestion-index + delta + root.suggestions.length,
                root.suggestions.length);
        }
    }

    function accept-suggestion() {
        if (root.suggestion-index >= 0 && root.suggestion-index < root.suggestions.length) {
            root.suggestion-clicked(root.pane-id, root.suggestions[root.suggestion-index]);
            root.suggestion-index = -1;
        }
    }

    changed suggestions => { root.suggestion-index = -1; }

    key-pressed(event) => {
        // Mientras un editor de texto tiene el foco (rename inline o edición de ruta), las
        // teclas son de ESE editor: hay que RECHAZAR el evento para que el LineEdit aplique
        // su manejo por defecto (mover el caret con flechas/Home/End, borrar con
        // Backspace/Delete). Un `accept` aquí se COMÍA esas teclas (bug: no se podía editar
        // a mitad del nombre; el caret quedaba pegado). Rechazar NO reenvía nada a Rust,
        // así que el typeahead/atajos tampoco se gatillan con el editor abierto.
        // Hacerlo ANTES de `activate` garantiza que AltGr (Ctrl+Alt) inserte «\\» en una
        // ruta, en vez de exponerlo al manejador global de atajos del panel.
        if (root.rename-pos != -1 || root.editing) {
            return reject;
        }
        root.activate(root.pane-id);
        root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
        return accept;
    }

    // Al soltar una tecla, reportamos el estado vigente de los modificadores. Cuando se suelta
    // Ctrl, `event.modifiers.control` ya viene en false, así que Rust limpia `ctrl_down` (idem
    // Shift). Es la fuente más fiable: rastrea el estado real, no adivina por el texto.
    key-released(event) => {
        root.key-release(event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
        accept
    }

    // C2: al entrar a rename el `body-touch` se desmonta y `hover-row` se queda congelado en la
    // última fila bajo el cursor → quedaría una fila con el fondo de hover pegado. Lo limpiamos al
    // empezar a editar (y también al salir, por simetría: el puntero pudo moverse con el editor
    // tapando el cuerpo). Además, al CERRAR el editor (pos vuelve a -1) hay que devolver el foco
    // de teclado al panel: el LineEdit destruido se lo llevaba y el panel quedaba muerto al
    // teclado (F2/flechas) hasta el próximo clic. Se difiere con un Timer de 0 ms por la misma
    // razón que el foco del propio editor (llamar `focus()` durante la actualización de
    // propiedades/layout paniquea con "Recursion detected").
    changed rename-pos => {
        root.hover-row = -1;
        // Sesión NUEVA (o cierre): la selección inicial del ciclo F2 vuelve a estar pendiente.
        // (rename-cursor NO se resetea aquí: es `in` desde la ventana y Rust lo siembra al abrir.)
        root.rename-seeded = false;
        if (root.rename-pos == -1) {
            refocus-after-rename.running = true;
        }
    }
    refocus-after-rename := Timer {
        interval: 0ms;
        running: false;
        triggered => {
            self.running = false;
            root.focus();
        }
    }

    // Mismo motivo que arriba para el arrastre OLE: mientras dura el drag el `body-touch` está
    // desmontado y `hover-row` se quedaría congelado en la fila que estaba bajo el cursor al empezar
    // → un resaltado fantasma pegado. Lo limpiamos al entrar Y al salir del arrastre (al salir, el
    // cursor pudo terminar sobre otro panel: este no debe mostrar hover hasta que el TouchArea
    // re-montado reciba un `moved` real).
    changed drag-in-progress => { root.hover-row = -1; }

    // Cuando este panel pasa a ser el activo, tomar el foco de teclado para que las teclas
    // lleguen sin necesidad de un clic previo (p. ej. tras Tab o al arrancar).
    changed active => {
        if (root.active) {
            root.focus();
        }
    }

    // Marca del panel activo: borde de acento MÁS marcado (2px) + una sutil bruma de acento de
    // fondo, para que se distinga claramente del panel inactivo de un vistazo.
    // DRAG-OVER (arrastrando un archivo sobre este panel): borde AÚN más grueso (3px) de acento a
    // plena intensidad + bruma más notoria, para gritar "aquí soltarás". Manda sobre `active`.
    Rectangle {
        border-width: root.drag-over ? 2px : 1px;
        border-color: (root.drag-over || root.active) ? Theme.active-pane-border : Theme.divider;
        border-radius: Theme.radius-sm;
        background: root.active ? Theme.active-panel-bg : Theme.inactive-panel-bg;
        VerticalLayout {
            // --- Barra de ruta: breadcrumbs (modo normal) o editor con autocompletado. ---
            Rectangle {
                height: !root.editing && root.width < 480px && (root.comparison-active || root.comparison-link-available) ? 54px : 28px;
                // Cuando el panel está activo, la path-bar lleva un fondo de acento tenue para
                // resaltar dónde está el foco. Al arrastrar encima (drag-over) se remarca más fuerte
                // para reforzar que ese es el destino del drop.
                background: root.drag-over
                    ? Theme.accent.with-alpha(0.30)
                    : (root.active ? Theme.active-pane-bg : Theme.header-bg);
                border-radius: Theme.radius-sm;
                Rectangle {
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: root.active ? Theme.active-pane-border : Theme.divider;
                }
                // Modo BREADCRUMB: segmentos clicables; clic en el hueco entra a edición.
                if !root.editing: HorizontalLayout {
                    height: 28px;
                    padding-left: 4px;
                    spacing: 0px;
                    // Navegación local: cada panel conserva su propio historial. Los botones se
                    // sitúan junto a la ruta para que un panel secundario no obligue a mirar la
                    // toolbar global ni a activarlo antes de usar Atrás/Adelante.
                    PanelNavButton {
                        glyph: "‹";
                        tip: Tr.nav-back-tip;
                        enabled: root.can-go-back;
                        clicked => { root.nav-back(root.pane-id); }
                        history-menu(x) => { root.open-back-history(root.pane-id, x); }
                        hover-tip(t, x, y) => { root.hover-tip(t, x, y); }
                    }
                    if root.width > 440px: PanelNavButton {
                        glyph: "⌄";
                        tip: Tr.nav-back-history-tip;
                        enabled: root.can-go-back;
                        clicked => { root.open-back-history(root.pane-id, self.absolute-position.x + self.width / 2); }
                        hover-tip(t, x, y) => { root.hover-tip(t, x, y); }
                    }
                    PanelNavButton {
                        glyph: "›";
                        tip: Tr.nav-forward-tip;
                        enabled: root.can-go-forward;
                        clicked => { root.nav-forward(root.pane-id); }
                        history-menu(x) => { root.open-forward-history(root.pane-id, x); }
                        hover-tip(t, x, y) => { root.hover-tip(t, x, y); }
                    }
                    if root.width > 440px: PanelNavButton {
                        glyph: "⌄";
                        tip: Tr.nav-forward-history-tip;
                        enabled: root.can-go-forward;
                        clicked => { root.open-forward-history(root.pane-id, self.absolute-position.x + self.width / 2); }
                        hover-tip(t, x, y) => { root.hover-tip(t, x, y); }
                    }
                    PanelNavButton {
                        glyph: "↑";
                        tip: Tr.toolbar-up-tip;
                        clicked => { root.nav-up(root.pane-id); }
                        hover-tip(t, x, y) => { root.hover-tip(t, x, y); }
                    }
                    BreadcrumbBar {
                        segments: root.segments;
                        available-height: root.height;
                        navigate(path) => { root.activate(root.pane-id); root.segment-clicked(root.pane-id, path); }
                        context(path, x, y) => { root.activate(root.pane-id); root.segment-context(root.pane-id, path, x, y); }
                        edit() => { root.activate(root.pane-id); root.path-edit-start(root.pane-id); }
                        hover-tip(t, x, y) => { root.hover-tip(t, x, y); }
                    }
                    // ★ favorito (toggle): lleno si la carpeta ya está anclada.
                    Rectangle {
                        width: 24px;
                        background: fav-touch.has-hover ? Theme.hover-bg : transparent;
                        border-radius: Theme.radius-sm;
                        StarIcon {
                            width: 100%;
                            height: 100%;
                            filled: root.is-favorite;
                            tint: root.is-favorite ? Theme.highlight : Theme.text-dim;
                        }
                        fav-touch := TouchArea {
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    root.fav-toggle(root.pane-id);
                                }
                            }
                            changed has-hover => {
                                root.hover-tip(self.has-hover ? Tr.pathbar-fav-tip : "",
                                    self.absolute-position.x + self.width / 2,
                                    self.absolute-position.y + self.height);
                            }
                        }
                    }
                    // 📋 copiar la ruta de la carpeta al portapapeles. Al copiar, el ícono cambia
                    // a ✓ por ~1s (feedback inmediato en el lugar del clic).
                    copy-box := Rectangle {
                        width: 26px;
                        background: copy-touch.has-hover ? Theme.hover-bg : transparent;
                        border-radius: Theme.radius-sm;
                        property <bool> flashed: false;
                        // ✓ al copiar, si no el portapapeles. Ambos dibujados con Path.
                        if copy-box.flashed: CheckIcon { width: 100%; height: 100%; tint: Theme.highlight; }
                        if !copy-box.flashed: ClipboardIcon { width: 100%; height: 100%; tint: Theme.text; }
                        // Apaga el ✓ tras ~1s.
                        flash-timer := Timer {
                            interval: 1s;
                            running: copy-box.flashed;
                            triggered => { copy-box.flashed = false; self.running = false; }
                        }
                        copy-touch := TouchArea {
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    root.copy-path(root.pane-id);
                                    copy-box.flashed = true;
                                }
                            }
                            changed has-hover => {
                                root.hover-tip(self.has-hover ? Tr.pathbar-copy-tip : "",
                                    self.absolute-position.x + self.width / 2,
                                    self.absolute-position.y + self.height);
                            }
                        }
                    }
                    // Botón toggle de vista profunda: tres líneas escalonadas. Se pinta con
                    // fondo de acento cuando está activo o al pasar el cursor.
                    Rectangle {
                        width: 26px;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: root.deep-active
                            ? Theme.pressed-bg
                            : (deep-touch.has-hover ? Theme.hover-bg : transparent);
                        Path {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            stroke: (deep-touch.has-hover || root.deep-active) ? white : Theme.text-dim;
                            stroke-width: 1.3px;
                            fill: transparent;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            MoveTo { x: 1; y: 3; }   LineTo { x: 9; y: 3; }
                            MoveTo { x: 4; y: 7; }   LineTo { x: 12; y: 7; }
                            MoveTo { x: 7; y: 11; }  LineTo { x: 13; y: 11; }
                        }
                        deep-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-deep(root.pane-id); }
                            changed has-hover => {
                                root.hover-tip(self.has-hover ? Tr.deep-view-tip : "",
                                    self.absolute-position.x + self.width / 2,
                                    self.absolute-position.y + self.height);
                            }
                        }
                    }
                    Rectangle {
                        width: root.width >= 480px && (root.comparison-active || root.comparison-link-available)
                            ? (root.comparison-active ? 130px : 24px) : 0px;
                    }
                }
                    // En paneles estrechos la comparación usa otra fila, sin quitar acciones.
                    // Acciones F-8, visibles solo para una comparación viva. Los glifos cortos
                    // no compiten con los breadcrumbs en paneles angostos: ≠ selecciona los
                    // distintos, ⊘ los que existen solo aquí, C/M los transfiere al otro lado.
                    if !root.editing && (root.comparison-active || root.comparison-link-available): Rectangle {
                        width: root.comparison-active ? 130px : 24px; height: 22px;
                        x: parent.width - self.width;
                        y: root.width < 480px ? 30px : 3px;
                        HorizontalLayout {
                            spacing: 1px;
                            if root.comparison-active: Rectangle {
                                width: 64px;
                                HorizontalLayout {
                                    spacing: 1px;
                                    for action in [1, 2, 3]: Rectangle {
                                width: 20px; height: 22px; border-radius: Theme.radius-sm;
                                background: action-touch.has-hover ? Theme.hover-bg : transparent;
                                Text { text: action == 1 ? "≠" : (action == 2 ? "⊘" : "="); color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                                action-touch := TouchArea {
                                    clicked => { root.comparison-select(root.pane-id, action); }
                                    changed has-hover => { root.hover-tip(self.has-hover ? (action == 1 ? Tr.comparison-select-different-tip : (action == 2 ? Tr.comparison-select-only-here-tip : Tr.comparison-hide-equal-tip)) : "", self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height); }
                                }
                                    }
                                }
                            }
                            if root.comparison-active: Rectangle {
                                width: 42px;
                                HorizontalLayout {
                                    spacing: 1px;
                                    for move-files in [false, true]: Rectangle {
                                width: 20px; height: 22px; border-radius: Theme.radius-sm;
                                background: transfer-touch.has-hover ? Theme.hover-bg : transparent;
                                Text { text: move-files ? "M" : "C"; color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
                                transfer-touch := TouchArea {
                                    clicked => { root.comparison-transfer(root.pane-id, move-files); }
                                    changed has-hover => { root.hover-tip(self.has-hover ? (move-files ? Tr.comparison-move-tip : Tr.comparison-copy-tip) : "", self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height); }
                                }
                                    }
                                }
                            }
                            if root.comparison-link-available: Rectangle {
                                width: 20px; height: 22px; border-radius: Theme.radius-sm;
                                background: root.comparison-link-active ? Theme.pressed-bg : (link-touch.has-hover ? Theme.hover-bg : transparent);
                                Text { text: "↔"; color: root.comparison-link-active ? Theme.text : Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; font-size: 11px; }
                                link-touch := TouchArea {
                                    clicked => { root.comparison-toggle-link(root.pane-id); }
                                    changed has-hover => { root.hover-tip(self.has-hover ? (root.comparison-link-active ? Tr.comparison-link-off-tip : Tr.comparison-link-on-tip) : "", self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height); }
                                }
                            }
                        }
                    }
                // Modo EDICIÓN: LineEdit con la ruta; Enter navega, Esc cancela, perder foco
                // (clic afuera) vuelve a los breadcrumbs.
                // Envuelto en HorizontalLayout (mismo patrón que los breadcrumbs de arriba) para
                // que el texto quede alineado a la izquierda; el estilo fluent centra el texto
                // de un LineEdit suelto sin layout.
                if root.editing: HorizontalLayout {
                    padding-left: 4px;
                    // Tomar el foco al abrir el editor (si no, el clic que lo abrió no enfoca
                    // el LineEdit y el "perder foco" nunca tendría foco que perder). Además
                    // selecciona todo el texto para que escribir reemplace la ruta completa.
                    // Se difiere con un Timer de 0 ms: en `init` el editor aún se está montando
                    // dentro de la evaluación de layout y `focus()` paniquea con "Recursion
                    // detected" (mismo bug que el crash de F2 del editor de rename). Un Timer
                    // no es ítem visual: no afecta el layout.
                    Timer {
                        interval: 0ms;
                        running: true;
                        triggered => {
                            self.running = false;
                            path-edit.focus();
                            path-edit.select-all();
                        }
                    }
                    // Completar una sugerencia cambia el texto DESDE el callback Rust. El
                    // toolkit conserva a veces el offset anterior (que cae dentro del nombre
                    // recién insertado); diferimos un tick y lo dejamos inequívocamente al final.
                    // El Timer no corre durante la escritura normal: solo cambia la revisión al
                    // aceptar una sugerencia, por lo que Home/End/flechas siguen editando libremente.
                    caret-timer := Timer {
                        interval: 0ms;
                        property <int> applied: -1;
                        running: root.edit-caret >= 0 && self.applied != root.edit-caret-revision;
                        triggered => {
                            self.running = false;
                            self.applied = root.edit-caret-revision;
                            path-edit.focus();
                            path-edit.set-selection-offsets(root.edit-caret, root.edit-caret);
                        }
                    }
                    path-edit := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.edit-text;
                        placeholder-text: "C:\\…";
                        edited(t) => {
                            root.suggestion-index = -1;
                            root.path-edit-changed(root.pane-id, t);
                        }
                        accepted(t) => { root.path-edit-commit(root.pane-id, t); }
                        // Al perder el foco (clic afuera) salir de edición → vuelve a breadcrumbs.
                        changed has-focus => {
                            if (!self.has-focus) {
                                root.path-edit-cancel(root.pane-id);
                            }
                        }
                        key-pressed(ev) => {
                            if (ev.text == Key.Escape) {
                                root.path-edit-cancel(root.pane-id);
                                return accept;
                            }
                            if (ev.text == Key.DownArrow) {
                                root.move-suggestion(1);
                                return accept;
                            }
                            if (ev.text == Key.UpArrow) {
                                root.move-suggestion(-1);
                                return accept;
                            }
                            if (ev.text == Key.Return && root.suggestion-index >= 0) {
                                root.accept-suggestion();
                                return accept;
                            }
                            // En algunos teclados Windows «\\» llega como AltGr (Ctrl+Alt).
                            // El TextInput de Slint trata esa combinación como atajo y no la
                            // inserta. La incorporamos explícitamente y la enviamos al mismo
                            // flujo async de autocompletado. Es el único carácter interceptado.
                            if (ev.text == "\\") {
                                root.suggestion-index = -1;
                                // Actualizar el buffer LOCAL primero: el siguiente carácter se
                                // inserta sobre la ruta ya extendida, aun si el callback Rust aún
                                // está preparando las sugerencias en su worker.
                                self.text = self.text + "\\";
                                root.path-edit-changed(root.pane-id, self.text);
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
            }
            // Autocompletado: lista flotante de candidatos bajo el editor (solo en edición).
            if root.editing && root.suggestions.length > 0: Rectangle {
                height: min(root.suggestions.length * 22px + 4px, 132px);
                background: Theme.surface-floating;
                border-width: 1px;
                border-color: Theme.divider;
                border-radius: Theme.radius-md;
                ListView {
                    for s[i] in root.suggestions: Rectangle {
                        height: 22px;
                        background: i == root.suggestion-index ? Theme.selection-bg
                            : (sug-touch.has-hover ? Theme.hover-bg : transparent);
                        Text {
                            text: "📁 " + s;
                            color: Theme.text;
                            vertical-alignment: center;
                            x: 6px;
                        }
                        sug-touch := TouchArea {
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    root.suggestion-clicked(root.pane-id, s);
                                }
                            }
                        }
                    }
                }
            }
            // Encabezado dinámico: una HeaderCell por columna visible, con su ancho persistido.
            // Clic = ordenar por esa columna; arrastrar el borde derecho = redimensionar (6C).
            // El botón "≡" al final abre el menú de columnas (agregar/quitar).
            HorizontalLayout {
                height: 24px;
                for col[ci] in root.columns: HeaderCell {
                    width: col.width;
                    text: col.label;
                    align-right: col.align-right;
                    sort-dir: col.sort-dir;
                    has-filter: col.has-filter;
                    clicked => {
                        root.sort-by-kind(root.pane-id, col.kind);
                    }
                    context-menu(x, y) => {
                        root.column-context(root.pane-id, col.kind, x, y);
                    }
                    resize(delta) => {
                        root.column-resize(root.pane-id, col.kind, col.width + delta);
                    }
                }
                // Botón de menú de columnas (al final, ancho fijo).
                Rectangle {
                    width: 24px;
                    background: colbtn-touch.has-hover ? Theme.hover-bg : Theme.header-bg;
                    border-width: 1px;
                    border-color: Theme.divider;
                    Text { text: "≡"; color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                    colbtn-touch := TouchArea {
                        clicked => { root.col-menu-open = !root.col-menu-open; }
                    }
                }
            }
            // Cuerpo de la lista. El ListView va con `interactive: false`: su Flickable arbitraba
            // los `move` con botón apretado para hacer scroll y CANCELABA el TouchArea de cada
            // fila, de modo que ni el arrastre OLE ni la selección por rectángulo recibían los
            // `move` (el clic sí, porque el Flickable reenvía press+release sin movimiento). Ahora
            // un único TouchArea exterior (`body-touch`, hermano POSTERIOR del ListView, por
            // ENCIMA en z-order) captura TODOS los eventos crudos y deduce la fila por la `y` + el
            // scroll. La rueda se re-implementa con `scroll-event` sobre el viewport nativo.
            Rectangle {
                // I5: durante el rename, un TouchArea de fondo de BAJA prioridad (primer hijo → por
                // DEBAJO del ListView en z-order) que existe SOLO mientras se edita. La fila-editor
                // es un LineEdit real que queda POR ENCIMA, así que sigue recibiendo sus clics; pero
                // un clic en el resto del cuerpo (zona vacía / otra fila) cae a este TouchArea —el
                // Flickable del ListView no es interactivo y reenvía el clic— y le quita el foco al
                // editor (lo lleva al FocusScope raíz). Eso dispara el `changed has-focus` del
                // LineEdit, que CONFIRMA el rename. Así clic-fuera cierra el rename como espera el
                // usuario. (No usamos `body-touch` aquí porque va por ENCIMA y taparía el editor.)
                if root.rename-pos != -1: TouchArea {
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.activate(root.pane-id);
                            root.focus();
                        }
                    }
                }
                list := ListView {
                // El ListView (std-widgets) NO expone `interactive`; su Flickable interno ya viene
                // con `interactive: false` en el estilo fluent, pero igual interceptaba el `move`
                // del TouchArea hijo. La solución es el `body-touch` exterior (abajo): al estar por
                // ENCIMA en z-order, agarra el puntero antes que el Flickable y le quita los
                // eventos. El scroll lo maneja `body-touch` por la rueda; `viewport-y` lee
                for row[i] in root.rows: Rectangle {
                    height: root.row-h;
                    // Fondo de la cebra para un panel NO activo. Tres casos:
                    //  - flat-inactive-panels ON  → TODAS las filas con row-inactive-bg (panel plano,
                    //    sin "líneas"), para que se distinga aún más del panel activo.
                    //  - flat OFF                 → cebra con row-inactive-bg de base + la franja sutil
                    //    en las impares (igual estructura que el panel activo, pero sobre el color de
                    //    inactivo). Con el default (row-inactive-bg = row-bg) no se nota el cambio.
                    property <brush> inactive-zebra: Theme.use-inactive-row-color
                        ? (Theme.flat-inactive-panels
                            ? Theme.row-inactive-bg
                            : (mod(i, 2) == 1 ? Theme.row-alt-bg.with-alpha(0.22) : Theme.row-inactive-bg))
                        : (mod(i, 2) == 1 ? Theme.row-alt-bg.with-alpha(0.22) : transparent);
                    // Fondo: selección > filtro > comparación > resaltado reciente > hover.
                    // > cebra de base. La selección, el filtro, el resaltado y el hover MANDAN por
                    // encima de activo/inactivo. La cebra de base depende de si el panel está
                    // activo: activo = cebra clásica (par transparente sobre el panel); inactivo =
                    // `inactive-zebra` (atenuable o plana). El tinte del filtro es discreto (alfa
                    // bajo) para no pelear con la selección ni con el texto.
                    background: row.selected
                        ? (root.active ? Theme.selection-bg : Theme.selection-inactive-bg)
                        : (row.filter-match
                            ? Theme.accent.with-alpha(0.18)
                            : (row.compare-state == 2
                                ? #d97706aa.with-alpha(0.30)
                                : (row.compare-state == 1
                                    ? #dc2626aa.with-alpha(0.24)
                                    : (row.highlight
                                        ? Theme.highlight.with-alpha(0.22)
                                        : (i == root.hover-row
                                            ? Theme.hover-bg
                                            : (root.active
                                                ? (mod(i, 2) == 1 ? Theme.row-alt-bg.with-alpha(0.22) : transparent)
                                                : self.inactive-zebra))))));
                    border-width: row.focused ? 1px : 0px;
                    border-color: root.active ? Theme.active-pane-border : Theme.text-dim;
                    border-radius: Theme.radius-sm;
                    HorizontalLayout {
                        padding-left: 6px;
                        // Atenuar las filas cortadas (Ctrl+X) hasta pegar.
                        opacity: row.cut ? 0.45 : 1.0;
                        // Celdas dinámicas: una por columna visible, con su ancho. La columna Name
                        // (kind 0) se pinta como ícono + nombre; las demás como texto de `cells[ci]`.
                        // El ícono cacheado (6A) cuesta como un glifo: no se re-rasteriza por frame.
                        for col[ci] in root.columns: Rectangle {
                            width: col.width;
                            // El orden es una pista secundaria, nunca tapa selección o alertas.
                            background: root.active && col.sort-dir != 0 && !row.selected
                                && !row.filter-match && row.compare-state == 0 && !row.highlight
                                && i != root.hover-row ? Theme.accent.with-alpha(0.08) : transparent;
                            HorizontalLayout {
                            // Las columnas numéricas/fechas necesitan aire propio; no tocar el
                            // ancho persistido, solo separar el contenido para que "Tamaño" y
                            // "Modificado" no se lean como una sola columna en paneles estrechos.
                            spacing: col.kind == 2 || col.kind == 3 || col.kind == 4 ? 10px : 6px;
                            padding-left: col.kind == 3 || col.kind == 4 ? 8px : 0px;
                            padding-right: col.kind == 2 ? 6px : 0px;
                            // Sangría por profundidad (vista profunda). depth=0 => sin efecto.
                            if col.kind == 0 && row.depth > 0: Rectangle { width: row.depth * 14px; }
                            if col.kind == 0: Image {
                                source: row.icon;
                                width: 16px;
                                height: 16px;
                                vertical-alignment: center;
                                image-rendering: smooth;
                            }
                            // Editor inline de rename (6D): en la celda Name de la fila en edición.
                            // Enter confirma; ↑/↓ encadenan al anterior/siguiente; Esc cancela.
                            // El Rectangle solo existe para alojar el Timer de foco (un LineEdit
                            // no admite hijos); ocupa exactamente el mismo espacio de layout.
                            if col.kind == 0 && root.rename-pos == i: Rectangle {
                                horizontal-stretch: 1;
                                // El foco NO se puede tomar en `init`: este editor se monta DENTRO
                                // de la evaluación de layout (el `if` se crea al resolver el
                                // layout de la celda) y `focus()` consulta la geometría del ítem
                                // (posición del IME) → re-evalúa el mismo layout → Slint paniquea
                                // con "Recursion detected" (crash histórico de F2). El Timer de
                                // 0 ms difiere el foco a la siguiente vuelta del event loop, ya
                                // fuera de toda evaluación de propiedades.
                                Timer {
                                    interval: 0ms;
                                    running: true;
                                    triggered => {
                                        self.running = false;
                                        // La sesión se CAPTURA por valor al montar el editor. Si se
                                        // leyera `root.rename-session` en vivo al disparar el
                                        // callback, un commit tardío (pérdida de foco al destruirse
                                        // este editor) llevaría la sesión del editor SIGUIENTE: el
                                        // guard del controlador la aceptaría, consumiría esa sesión
                                        // y cerraría el editor recién abierto por el chain (o peor:
                                        // renombraría el archivo equivocado).
                                        rename-edit.session = root.rename-session;
                                        // El text se fija SOLO aquí, al montar: nombre original
                                        // (primera vez) o draft recuperado (re-montaje). Nunca por
                                        // binding (eso reseteaba el cursor en cada tecla).
                                        rename-edit.text = root.rename-draft;
                                        rename-edit.focus();
                                        // La selección inicial (ciclo F2: nombre → ext → todo) SOLO
                                        // se aplica en el PRIMER montaje de la sesión. Si el delegate
                                        // se re-monta (rebuild de filas), el draft ya trae lo tipeado
                                        // y re-seleccionar haría que la próxima tecla lo borre todo:
                                        // se restaura solo la POSICIÓN DEL CURSOR guardada.
                                        if (!root.rename-seeded) {
                                            root.rename-seeded = true;
                                            rename-edit.set-selection-offsets(
                                                root.rename-selection-start,
                                                root.rename-selection-end);
                                        } else {
                                            rename-edit.set-selection-offsets(
                                                root.rename-cursor,
                                                root.rename-cursor);
                                        }
                                    }
                                }
                                rename-edit := LineEdit {
                                width: 100%;
                                height: 100%;
                                // `text` NO es un binding: se fija UNA vez al montar (Timer,
                                // desde rename-draft). Un binding `text: rename-draft` reescribe
                                // el text en CADA tecla (edited → draft → binding) y Slint
                                // resetea el cursor al FINAL en cada escritura: por eso el "_"
                                // "se iba al final del nombre" y no se podía insertar a mitad.
                                font-size: 13px;
                                // El draft se actualiza por tecla, SIN binding de vuelta al text:
                                // solo sirve para recuperar el contenido si el delegate se re-monta.
                                edited(t) => {
                                    root.rename-draft = t;
                                    root.rename-edited(t);
                                }
                                // Sesión de ESTE editor, capturada por el Timer al montarlo.
                                // -1 = aún no inicializada: ningún callback puede pasar el guard.
                                property <int> session: -1;
                                accepted => {
                                    root.rename-commit(self.session, i, self.text);
                                }
                                // Perder el foco confirma. La sesión viaja con el callback para que
                                // Enter/Esc/chain puedan destruir este editor sin confirmar dos veces.
                                changed has-focus => {
                                    if (!self.has-focus) {
                                        root.rename-commit(self.session, i, self.text);
                                    }
                                }
                                key-pressed(ev) => {
                                    // F2 DENTRO del editor: cicla la selección (nombre →
                                    // extensión → todo → nombre). El gate del panel no deja
                                    // llegar F2 a Rust con el rename abierto, así que lo
                                    // maneja el propio editor.
                                    if (ev.text == Key.F2) {
                                        root.rename-cycle();
                                        return accept;
                                    }
                                    if (ev.text == Key.Escape) {
                                        root.rename-cancel();
                                        return accept;
                                    }
                                    if (ev.text == Key.UpArrow) {
                                        root.rename-chain(self.session, i, self.text, -1);
                                        return accept;
                                    }
                                    if (ev.text == Key.DownArrow) {
                                        root.rename-chain(self.session, i, self.text, 1);
                                        return accept;
                                    }
                                    reject
                                }
                                }
                            }
                            // Celda Name CON match del filtro: el tramo que coincide se pinta
                            // en acento + negrita (pre/match/post), el resto con su color normal.
                            // spacing/padding en 0 y stretch 0 en los Text: cada tramo mide
                            // EXACTAMENTE su texto, así el resaltado no mueve ni un píxel el
                            // layout del nombre (con stretch 1 cada caja tomaba un tercio del
                            // ancho y quedaban "espacios" alrededor del match).
                            if col.kind == 0 && row.filter-match && root.rename-pos != i: HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 0;
                                padding: 0;
                                Text {
                                    text: row.match-pre;
                                    color: row.is-dir ? Theme.folder-text : Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.match-mid;
                                    color: Theme.accent;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: row.match-post;
                                    color: row.is-dir ? Theme.folder-text : Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                    overflow: elide;
                                }
                            }
                            if !(col.kind == 0 && root.rename-pos == i) && !(col.kind == 0 && row.filter-match): Text {
                                text: row.cells[ci];
                                color: col.kind == 0
                                    ? (row.is-dir ? Theme.folder-text : Theme.text)
                                    : Theme.text-dim;
                                vertical-alignment: center;
                                horizontal-alignment: col.align-right ? right : left;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            }
                        }
                    }
                    // La fila es solo VISUAL: ya no lleva TouchArea propio. Todo el input lo captura
                    // `body-touch` (abajo), por encima del ListView.
                }
                }
                // TouchArea exterior: ÚLTIMO hijo del cuerpo (por ENCIMA del ListView en z-order),
                // captura TODOS los eventos crudos y deduce la fila por la `y` + el scroll. Se
                // oculta durante el rename inline para no tapar el editor de la celda Name (durante
                // el rename no se necesita clic-en-vacío). También se DESMONTA si hay un modal abierto
                // (`modal-open`): así no roba hover/clic al velo del modal; vuelve al cerrarse este.
                if root.rename-pos == -1 && !root.modal-open && !root.drag-in-progress: body-touch := TouchArea {
                    // Estado del gesto en curso. `pressed-here`: hay un press de botón izquierdo
                    // vivo. `dragging`: ya se disparó el arrastre OLE (no repetir). `press-x/y`:
                    // dónde empezó (umbral clic-vs-arrastre). `start-row`: fila bajo el press.
                    property <bool> pressed-here: false;
                    property <bool> dragging: false;
                    property <length> press-x;
                    property <length> press-y;
                    property <int> start-row: -1;
                    // Fila ABSOLUTA bajo el cursor. `viewport-y` es 0 arriba y NEGATIVO al bajar, así
                    // que `mouse-y - viewport-y` = posición absoluta en el contenido. Puede caer
                    // fuera de rango (zona vacía): el llamador valida contra `rows.length`.
                    property <int> cur-row: floor((self.mouse-y - list.viewport-y) / root.row-h);
                    // ¿`start-row` es una fila real Y estaba seleccionada? (decide OLE vs rubber-band)
                    property <bool> start-selected:
                        self.start-row >= 0 && self.start-row < root.rows.length
                            ? root.rows[self.start-row].selected
                            : false;
                    // Hover: expón la fila bajo el cursor para que el fondo de la fila la resalte.
                    // -1 cuando el puntero no está sobre el cuerpo o cae en zona vacía.
                    changed has-hover => {
                        root.hover-row = (self.has-hover && self.cur-row >= 0 && self.cur-row < root.rows.length)
                            ? self.cur-row : -1;
                    }
                    moved => {
                        root.hover-row = (self.has-hover && self.cur-row >= 0 && self.cur-row < root.rows.length)
                            ? self.cur-row : -1;
                        // Inicio de ARRASTRE OLE: botón abajo, movimiento > umbral, con el press sobre
                        // una FILA REAL (esté o no seleccionada) → sacar lo elegido. Así arrastrar un
                        // archivo de un tirón (clic + arrastre en un solo gesto) funciona, como en el
                        // Explorador de Windows. Si la fila NO estaba seleccionada, se selecciona ella
                        // sola primero (row-clicked sin modificadores) para arrastrar lo correcto.
                        // Umbral de 12px (antes 6px): subido a propósito para reducir arrastres OLE
                        // accidentales por micro-movimientos del mouse al hacer clic (decisión de
                        // Nicolás: "umbral mayor + confirmar al soltar"). El rubber-band de abajo usa
                        // el mismo umbral por consistencia.
                        if (self.pressed-here && !self.dragging
                            && self.start-row >= 0 && self.start-row < root.rows.length
                            && (abs(self.mouse-x - self.press-x) > 12px || abs(self.mouse-y - self.press-y) > 12px)) {
                            self.dragging = true;
                            self.pressed-here = false;
                            root.activate(root.pane-id);
                            if (!self.start-selected) {
                                // Al iniciar un arrastre, seleccionar SOLO esa fila (sin Ctrl/Shift)
                                // para arrastrar lo correcto, sin importar el estado de teclas.
                                root.row-clicked(root.pane-id, self.start-row, false, false);
                            }
                            root.row-drag-out(root.pane-id);
                        }
                        // RUBBER-BAND (6F): arrastrar desde ZONA VACÍA (el press NO cayó sobre ninguna
                        // fila) selecciona el rango [start-row, cur-row], ambos ABSOLUTOS. Rust
                        // (select_rect_range) ordena y recorta el rango; Ctrl = aditivo. El alto de
                        // fila usa `row-h` (no 22px hardcodeado como el rubber-band viejo). Arrastrar
                        // SOBRE una fila ya no hace rubber-band: hace arrastre OLE (arriba).
                        if (self.pressed-here && !self.dragging
                            && (self.start-row < 0 || self.start-row >= root.rows.length)
                            && abs(self.mouse-y - self.press-y) > 12px) {
                            root.activate(root.pane-id);
                            root.rubber-band(root.pane-id, self.start-row, self.cur-row);
                        }
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            self.pressed-here = true;
                            self.dragging = false;
                            self.press-x = self.mouse-x;
                            self.press-y = self.mouse-y;
                            self.start-row = self.cur-row;
                            root.activate(root.pane-id);
                            root.focus();
                        }
                        // Soltar el botón izquierdo SIN haber arrastrado = clic. Sobre fila válida →
                        // seleccionar (Rust aplica Ctrl/Shift) y tomar el foco para que Supr/Ctrl+C
                        // lleguen al panel. En zona vacía: solo activar (ya se hizo en el down).
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left && self.pressed-here) {
                            self.pressed-here = false;
                            if (self.cur-row >= 0 && self.cur-row < root.rows.length) {
                                // Modificadores REALES del clic (del propio evento, no del estado
                                // sticky del controlador, que podía quedar pegado tras un modal/drag).
                                root.row-clicked(root.pane-id, self.cur-row, ev.modifiers.control, ev.modifiers.shift);
                                root.focus();
                            }
                        }
                        // Botones laterales del mouse: atrás/adelante en el historial del panel.
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.back) {
                            root.nav-back(root.pane-id);
                        }
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.forward) {
                            root.nav-forward(root.pane-id);
                        }
                        // Clic con el botón central (rueda) sobre una fila que es carpeta: abrirla
                        // SIEMPRE en un panel NUEVO (Rust valida que sea carpeta; sobre un archivo
                        // no hace nada).
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.middle) {
                            root.activate(root.pane-id);
                            if (self.cur-row >= 0 && self.cur-row < root.rows.length) {
                                root.row-middle-clicked(root.pane-id, self.cur-row);
                            }
                        }
                        // Clic derecho: sobre fila válida la selecciona y abre el menú del ARCHIVO;
                        // en zona vacía abre el menú de la CARPETA. Coords en la ventana
                        // (absolute-position + puntero).
                        if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.right) {
                            root.activate(root.pane-id);
                            if (self.cur-row >= 0 && self.cur-row < root.rows.length) {
                                root.row-clicked(root.pane-id, self.cur-row, false, false);
                                root.row-context(
                                    root.pane-id, self.cur-row,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            } else {
                                root.empty-context(
                                    root.pane-id,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        if (ev.kind == PointerEventKind.cancel) {
                            self.pressed-here = false;
                            self.dragging = false;
                        }
                    }
                    // Doble clic NATIVO de Slint (cronometrado por el SO, robusto bajo render por
                    // software). Camino primario para abrir; la detección por tiempo en Rust queda
                    // de respaldo (evita la doble navegación, ver on_row_double_clicked).
                    double-clicked => {
                        if (self.cur-row >= 0 && self.cur-row < root.rows.length) {
                            root.row-double-clicked(root.pane-id, self.cur-row);
                        }
                    }
                    // Scroll por rueda: el ListView ya no lo hace (interactive:false). Movemos
                    // `viewport-y` queda en [-alto-scrollable, 0]. `delta-y` es negativo al rodar
                    // hacia abajo, así que sumarlo BAJA el viewport. Si el contenido cabe entero,
                    // el clamp deja el valor en 0.
                    scroll-event(ev) => {
                        list.viewport-y = clamp(
                            list.viewport-y + ev.delta-y,
                            -max(0px, root.rows.length * root.row-h - list.visible-height),
                            0px);
                        root.scroll-position-changed(root.pane-id, floor(-list.viewport-y / root.row-h));
                        return accept;
                    }
                }
                // Barra de scroll del cuerpo: pista + manija arrastrable, visible solo cuando el
                // contenido excede lo visible. Da idea del tamaño de la carpeta y de la posición
                // en ella. Va como ÚLTIMO hijo (por encima del body-touch, que si no se traga el
                // arrastre). La manija refleja `viewport-y`: rueda, teclado y arrastre convergen
                // en la misma propiedad nativa.
                if root.rows.length * root.row-h > list.visible-height: Rectangle {
                    x: parent.width - 7px;
                    y: 0;
                    width: 7px;
                    height: parent.height;
                    background: Theme.row-alt-bg.with-alpha(0.22);
                    property <length> total: root.rows.length * root.row-h;
                    property <length> visible-h: list.visible-height;
                    property <length> handle-h: max(24px, parent.height * (visible-h / total));
                    property <length> handle-y: -list.viewport-y / (total - visible-h) * (parent.height - handle-h);
                    handle := Rectangle {
                        x: 1px;
                        y: handle-y;
                        width: 5px;
                        height: handle-h;
                        border-radius: 3px;
                        background: scroll-touch.has-hover || scroll-touch.pressed
                            ? Theme.accent
                            : Theme.text-dim.with-alpha(0.6);
                    }
                    scroll-touch := TouchArea {
                        property <length> grab-y;
                        property <length> grab-scroll;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                grab-y = self.mouse-y;
                                grab-scroll = -list.viewport-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                list.viewport-y = -clamp(
                                    grab-scroll + (self.mouse-y - grab-y) * (total / parent.height),
                                    0px,
                                    total - visible-h);
                                root.scroll-position-changed(root.pane-id, floor(-list.viewport-y / root.row-h));
                            }
                        }
                    }
                }
            }
            // Mini-barra del filtro visual por tipeo: visible mientras hay filtro activo en
            // este panel (hace el buffer de tipeo descubrible: no solo vive en el footer).
            // La ✕ lo limpia (mismo efecto que Esc). Va justo sobre el footer.
            if root.filter-label != "": Rectangle {
                height: 22px;
                background: Theme.accent.with-alpha(0.12);
                // Borde superior fino que la separa del contenido (igual que el footer).
                Rectangle { y: 0; height: 1px; width: parent.width; background: Theme.divider; }
                Text {
                    x: 8px;
                    width: parent.width - 66px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: root.filter-label;
                    color: Theme.text;
                    font-size: Theme.font-md;
                    overflow: elide;
                }
                clear-touch := TouchArea {
                    x: parent.width - 26px;
                    width: 26px;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.filter-clear(root.pane-id); }
                    Text {
                        text: "✕";
                        color: clear-touch.has-hover ? Theme.accent : Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // Toggle compacto: lleno = la vista muestra solamente las coincidencias.
                hide-touch := TouchArea {
                    x: parent.width - 52px;
                    width: 26px;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.filter-toggle-hide(root.pane-id); }
                    Text {
                        text: root.filter-hiding ? "●" : "○";
                        color: hide-touch.has-hover ? Theme.accent : Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    changed has-hover => {
                        root.hover-tip(self.has-hover ? Tr.filter-toggle-hide-tip : "",
                            self.absolute-position.x + self.width / 2,
                            self.absolute-position.y);
                    }
                }
            }
            // Barra inferior (footer): resumen de selección / espacio de disco. Va al FONDO del
            // panel como último hijo del VerticalLayout; alto fijo de 22px (la lista de arriba se
            // queda con el resto del alto). Solo se pinta si hay texto que mostrar.
            if root.footer-text != "": Rectangle {
                height: 22px;
                background: Theme.header-bg;
                // Borde superior fino que separa el footer del contenido.
                Rectangle { y: 0; height: 1px; width: parent.width; background: Theme.divider; }
                Text {
                    x: 8px;
                    width: root.footer-disk-text == "" ? parent.width - 16px : parent.width * 0.58 - 10px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: root.footer-text;
                    color: Theme.text-dim;
                    font-size: Theme.font-md;
                    overflow: elide;
                }
                // La información del volumen vive al extremo opuesto: queda siempre legible y
                // no empuja el contador de selección al achicar un panel.
                if root.footer-disk-text != "": Text {
                    x: parent.width * 0.58;
                    width: parent.width * 0.42 - 8px;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    text: root.footer-disk-text;
                    color: Theme.text-dim;
                    font-size: Theme.font-md;
                    overflow: elide;
                }
            }
        }
        // Menú "Columnas…" (6C): flota arriba-derecha al pulsar el botón ≡ del header. Cada
        // entrada togglea su columna; Name es fija (deshabilitada).
        if root.col-menu-open: Rectangle {
            x: parent.width - self.width - 8px;
            y: 50px;
            width: 180px;
            height: menu-col.preferred-height + 8px;
            background: Theme.surface-floating;
            border-color: Theme.divider;
            border-width: 1px;
            border-radius: Theme.radius-md;
            menu-col := VerticalLayout {
                padding: 4px;
                spacing: 2px;
                for item in root.col-menu: Rectangle {
                    height: 24px;
                    background: item-touch.has-hover && !item.fixed ? Theme.hover-bg : transparent;
                    border-radius: Theme.radius-sm;
                    HorizontalLayout {
                        padding-left: 6px;
                        spacing: 6px;
                        Text {
                            text: item.visible ? "✓" : "  ";
                            color: Theme.highlight;
                            width: 14px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: item.label;
                            color: item.fixed ? Theme.text-dim : Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    item-touch := TouchArea {
                        enabled: !item.fixed;
                        clicked => { root.column-toggle(root.pane-id, item.kind); }
                    }
                }
            }
        }
        // Aviso "sin coincidencias" (F2): centrado sobre la lista cuando un filtro la vació.
        if root.no-matches: Rectangle {
            y: parent.height / 2;
            height: 1px;
            Text {
                text: Tr.no-matches;
                color: Theme.text-dim;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }
        // Aviso "carpeta no encontrada" IN-PLACE: cubre el área del panel cuando su carpeta no
        // existe/ilegible (USB sacado, red caída, ruta muerta). Trae la ruta perdida + las 4
        // opciones (reintentar / subir / elegir otra / cerrar panel). Cada botón emite con el
        // pane-id para que el controlador actúe sobre ESTE panel.
        if root.missing: Rectangle {
            background: Theme.panel-bg;
            ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 10px;
                padding: 20px;
                Text {
                    text: root.missing-ejected ? Tr.missing-title-ejected : Tr.missing-title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.missing-ejected ? Tr.missing-body-ejected : Tr.missing-body;
                    color: Theme.text-dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: lost-txt.preferred-height + 12px;
                    background: Theme.row-bg;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    lost-txt := Text {
                        text: root.missing-path;
                        color: Theme.highlight;
                        font-size: 12px;
                        x: 8px;
                        width: max(0px, parent.width - 16px);
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                // Opciones (una por fila): reintentar / subir / elegir / cerrar. "Subir un nivel"
                // solo aparece si hay un ancestro existente real (si la unidad entera se
                // desconectó no tiene sentido: caería al HOME). Todas dependen solo de root.missing.
                MissingOpButton {
                    label: Tr.missing-retry;
                    clicked => { root.missing-retry(root.pane-id); }
                }
                if root.missing-has-ancestor: MissingOpButton {
                    label: Tr.missing-ancestor;
                    clicked => { root.missing-ancestor(root.pane-id); }
                }
                MissingOpButton {
                    label: Tr.missing-choose;
                    clicked => { root.missing-choose(root.pane-id); }
                }
                MissingOpButton {
                    label: Tr.missing-close;
                    clicked => { root.missing-close(root.pane-id); }
                }
            }
            }
        }
    }
}
